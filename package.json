{
  "name": "wadoagent",
  "displayName": "WadoAgent",
  "description": "Autonomous AI coding agent using local Ollama models",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "wadoagent.start",
        "title": "Start WadoAgent"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wadoagent-sidebar",
          "title": "WadoAgent",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "wadoagent-sidebar": [
        {
          "type": "webview",
          "id": "wadoagent.chatView",
          "name": "Chat"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^18.x",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "eslint": "^8.49.0",
    "typescript": "^5.2.2"
  }
}
